#!/bin/bash
# vista — occhi e metro per lavorare su modelli 3D senza vederli.
#
#   vista rendi <file.blend> [--etichetta prima] [--solo MainBody] [--viste fronte,alto,iso]
#   vista fatti <file.blend> [--solo MainBody]
#   vista confronta <cartella-prima> <cartella-dopo>
#   vista ciclo  <file.blend>          # rende "prima", aspetta, rende "dopo", confronta
#
# Le immagini vanno in .vista/ dentro il progetto (o in --cartella).
# Dopo `rendi`, APRI I PNG: è tutto il punto.

set -uo pipefail
BLENDER="${BLENDER:-/Applications/Blender.app/Contents/MacOS/Blender}"
QUI="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CMD="${1:-aiuto}"; shift 2>/dev/null || true

[ -x "$BLENDER" ] || { echo "Blender non trovato in $BLENDER — imposta \$BLENDER"; exit 1; }

# Filtra il rumore di Blender lasciando quello che conta.
pulisci() { grep -vE "^(Fra:|Info:|Read prefs|Read blend|Blender [0-9]|Time:|Saved:|unregister|.*addon (un)?registered|Cannot read|Update armature|Blender quit)|^$"; }

case "$CMD" in
  rendi)
    BLEND="${1:?serve un file .blend}"; shift
    CART=".vista"
    for ((i=1; i<=$#; i++)); do
      [ "${!i}" = "--cartella" ] && { j=$((i+1)); CART="${!j}"; }
    done
    "$BLENDER" -b "$BLEND" -P "$QUI/scripts/rendi.py" -- --cartella "$CART" "$@" 2>&1 | pulisci
    echo
    echo "→ ORA APRI LE IMMAGINI. Renderle e non guardarle non serve a niente."
    ;;

  fatti)
    BLEND="${1:?serve un file .blend}"; shift
    "$BLENDER" -b "$BLEND" -P "$QUI/scripts/ispeziona.py" -- "$@" 2>&1 | pulisci
    ;;

  confronta)
    python3 "$QUI/scripts/confronta.py" "$@"
    ;;

  ciclo)
    BLEND="${1:?serve un file .blend}"; shift
    echo "── 1/3  render PRIMA"
    "$BLENDER" -b "$BLEND" -P "$QUI/scripts/rendi.py" -- --cartella .vista --etichetta prima "$@" 2>&1 | pulisci
    echo
    echo "── 2/3  fai adesso la tua modifica al modello, poi premi INVIO"
    read -r _
    echo "── 3/3  render DOPO e confronto"
    "$BLENDER" -b "$BLEND" -P "$QUI/scripts/rendi.py" -- --cartella .vista --etichetta dopo "$@" 2>&1 | pulisci
    python3 "$QUI/scripts/confronta.py" .vista/prima .vista/dopo
    ;;

  *)
    sed -n '2,12p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
    ;;
esac
